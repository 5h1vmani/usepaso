{
  "private": true,
  "description": "UsePaso monorepo — dev tooling only, not published",
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/paso-js/src/**/*.ts": [
      "./packages/paso-js/node_modules/.bin/eslint --fix --config packages/paso-js/eslint.config.mjs",
      "./packages/paso-js/node_modules/.bin/prettier --write"
    ],
    "packages/paso-js/tests/**/*.ts": [
      "./packages/paso-js/node_modules/.bin/prettier --write"
    ],
    "packages/paso-py/**/*.py": [
      "python3 -m py_compile",
      "bash -c 'cd packages/paso-py && python3 -m mypy usepaso/ --ignore-missing-imports'"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
